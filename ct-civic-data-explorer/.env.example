PORT=3000
APP_BASE_URL=http://localhost:3000

DB_HOST=localhost
# Host port for the docker compose database (container port is always 5432)
DB_PORT=5433
DB_USER=ctdata
DB_PASSWORD=change-me
DB_NAME=civicdata

# Generate with: openssl rand -hex 32 (required when NODE_ENV=production)
SESSION_SECRET=
# true behind HTTPS; false for plain-http local development
COOKIE_SECURE=false
# true when running behind Nginx or another reverse proxy
TRUST_PROXY=false

# AI summary drafting (US009): none | anthropic
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=low
