# Copy to .env and fill in. The server lists every problem it finds here at startup.

PORT=3000
# The address people use to reach the app. Invite and password links are built from it.
# In production this must be the public https:// address.
APP_BASE_URL=http://localhost:3000

DB_HOST=localhost
# Host port for the docker compose MySQL database (container port is always 3306)
DB_PORT=3307
DB_USER=ctdata
DB_PASSWORD=change-me
DB_NAME=civicdata
# DB_POOL_MAX=10

# Required when NODE_ENV=production, which includes `docker compose up` of the app
# container. Generate with: openssl rand -hex 32
SESSION_SECRET=
# true behind HTTPS; false for plain-http local development
COOKIE_SECURE=false
# true when running behind Nginx or another reverse proxy
TRUST_PROXY=false

# Sites that may show /embed/<report>.html in an iframe: * for any, or a list of origins
# such as "https://www.example.org https://example.org"
EMBED_FRAME_ANCESTORS=*

# AI summary drafting (US009) and the data assistant chat: none | anthropic
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
