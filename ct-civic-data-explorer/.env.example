PORT=3000
APP_BASE_URL=http://localhost:3000

DB_HOST=localhost
# Host port for the docker compose MySQL database (container port is always 3306)
DB_PORT=3307
DB_USER=ctdata
DB_PASSWORD=change-me
DB_NAME=civicdata

# Generate with: openssl rand -hex 32 (required when NODE_ENV=production)
SESSION_SECRET=
# true behind HTTPS; false for plain-http local development
COOKIE_SECURE=false
# true when running behind Nginx or another reverse proxy
TRUST_PROXY=false

# Initial AI provider: google | openai | anthropic | compatible | none
AI_PROVIDER=google
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_COMPATIBLE_BASE_URL=https://provider.example/v1
# AI_COMPATIBLE_API_KEY=
# Optional model override for the initial provider
# AI_MODEL=gemini-3.5-flash-lite
