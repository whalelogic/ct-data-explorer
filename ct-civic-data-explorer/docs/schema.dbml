// CT Civic Data Explorer database schema, as built by migrations/001-004.
// Paste into https://dbdiagram.io to render the entity relationship diagram.
//
// The enums below are drawn as enums for readability; in PostgreSQL they are
// TEXT columns with CHECK constraints. schema_migrations (migration bookkeeping)
// is omitted.

Project ct_civic_data_explorer {
  database_type: 'PostgreSQL'
  Note: 'Long-format data model: a new dataset or indicator is an insert, never a migration.'
}

Enum user_role {
  admin
  staff
}

Enum token_purpose {
  invite
  reset
}

Enum geo_type {
  town
  state
}

Enum indicator_unit {
  count
  currency
  percent
  density
  area
}

Enum indicator_derivation {
  direct
  ratio
}

Table users {
  id serial [pk]
  email text [not null, unique, note: 'stored lowercase']
  password_hash text [note: 'NULL until the invite is accepted']
  first_name text [not null]
  last_name text [not null]
  role user_role [not null]
  is_active boolean [not null, default: true]
  failed_login_count integer [not null, default: 0]
  first_failed_login_at timestamptz
  locked_until timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table user_tokens {
  id serial [pk]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  purpose token_purpose [not null]
  token_hash text [not null, unique, note: 'SHA-256 of the one-time token']
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table session {
  sid varchar [pk]
  sess json [not null]
  expire timestamp(6) [not null]

  indexes {
    expire [name: 'session_expire_idx']
  }

  Note: 'Server-side sessions (connect-pg-simple). No foreign key; the user id lives inside sess.'
}

Table sources {
  id serial [pk]
  name text [not null, note: 'trimmed, non-empty']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(name)` [unique, name: 'sources_name_lower_idx']
  }
}

Table datasets {
  id serial [pk]
  name text [not null, note: "e.g. 'ACS 5-Year Town Profile'"]
  source_id integer [not null, ref: > sources.id]
  vintage text [not null, note: "e.g. '2024'"]
  version integer [not null]
  row_count integer [not null]
  uploaded_by integer [not null, ref: > users.id]
  uploaded_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: false]

  indexes {
    (name, vintage, version) [unique]
    (name, vintage) [unique, name: 'datasets_one_active_idx', note: 'partial: WHERE is_active']
    source_id [name: 'datasets_source_id_idx']
  }
}

Table towns {
  id serial [pk]
  name text [not null]
  geo_type geo_type [not null, note: "169 towns plus one 'state' row (Connecticut)"]
  square_miles numeric(10,2)

  indexes {
    (name, geo_type) [unique]
  }
}

Table indicators {
  id serial [pk]
  key text [not null, unique, note: 'lowercased CSV column name, ^[a-z0-9_]+$']
  label text [not null]
  unit indicator_unit [not null]
  decimals smallint [not null, default: 0, note: '0-4']
  derivation indicator_derivation [not null, default: 'direct']
  numerator_key text [note: 'required when derivation = ratio']
  denominator_key text [note: 'required when derivation = ratio']
}

Table observations {
  id serial [pk]
  dataset_id integer [not null, ref: > datasets.id]
  indicator_id integer [not null, ref: > indicators.id]
  town_id integer [not null, ref: > towns.id]
  value numeric(18,4) [not null]

  indexes {
    (dataset_id, indicator_id, town_id) [unique]
    (dataset_id, town_id) [name: 'observations_dataset_town_idx']
  }
}

Table cards {
  id serial [pk]
  title text [not null]
  selection jsonb [not null, note: 'towns, benchmark, indicators, title, layout (text, chart and table blocks)']
  created_by integer [not null, ref: > users.id]
  dataset_id integer [not null, ref: > datasets.id, note: 'version active when last saved']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    updated_at [name: 'cards_updated_at_idx', note: 'DESC']
  }
}
